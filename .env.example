# 复制本文件为 .env 后按本机路径修改（.env 勿提交）。
#
# ---------- Spring Insight ----------
# 1) 在 Spring Insight 工程执行: mvn clean install -DskipTests
# 2) 填写 MAVEN_REPO、INSIGHT_SERVER_JAR（与当前开发版 0.1.0-SNAPSHOT 对齐）
#
MAVEN_REPO=D:/Java/mvn_repo
INSIGHT_SERVER_JAR=D:/a-github-project/spring-insight/insight-server/target/insight-server-0.1.0-SNAPSHOT.jar
#
# ---------- 外部 Nacos（本机已启动，compose 不再拉起 Nacos）----------
DOCKER_NETWORK=my-network
NACOS_SERVER_ADDR=nacos-standalone:8848
NACOS_USERNAME=nacos
# 与 Nacos 控制台账号一致；compose 环境变量会覆盖 application-docker.yml
NACOS_PASSWORD=nacOsdev316
#
# 控制台：http://localhost:38848/nacos 或 http://localhost:38080/nacos
#
# 可选镜像：
# MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21
# JAVA_RUNTIME_IMAGE=eclipse-temurin:21-jre-alpine
#
# ---------- 宿主机端口（可选；被占用时请用 scripts/docker-up.ps1 自动改选）----------
# INSIGHT_HOST_PORT=9966
# GATEWAY_HOST_PORT=8080
# ORDER_HOST_PORT=8081
#
# ---------- insight-server 存储（仅 Server，与业务微服务无关）----------
# file（Demo 默认）= JSON 落盘到 Docker volume，重启可恢复；memory = 仅内存
# INSIGHT_STORAGE_MODE=file
