# 复制本文件为 .env 后按本机路径修改（.env 勿提交）。
#
# ---------- Spring Insight（业务侧依赖）----------
# 正式版可直接从 Maven Central 拉 starter；若用 SNAPSHOT 再本地 install。
# 监测中心请另外启动（本 compose 不再包含 insight-server）。
# 开发联调（本机 mvn package 后再打运行镜像，默认 sqlite）：
#   cd D:/a-github-project/spring-insight
#   mvn -pl insight-server -am package -DskipTests
#   docker compose -f compose.dev.yaml up -d --build
# 已发布镜像：
#   docker run --rm -p 9966:9966 \
#     -e SPRING_INSIGHT_SERVER_STORAGE_MODE=file \
#     -e SPRING_INSIGHT_SERVER_STORAGE_FILE_PATH=/data/spans.json \
#     -v spring-insight-data:/data \
#     ghcr.io/iweidujiang/spring-insight-server:0.1.0
#
MAVEN_REPO=D:/Java/mvn_repo
#
# 容器内访问宿主机上的 Server（默认）；若 Server 在同一 Docker 网且名为 insight-server：
# INSIGHT_SERVER_URL=http://insight-server:9966
INSIGHT_SERVER_URL=http://host.docker.internal:9966
#
# ---------- 外部 Nacos（本机已启动，compose 不拉起 Nacos）----------
DOCKER_NETWORK=my-network
NACOS_SERVER_ADDR=nacos-standalone:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacOsdev316
#
# 可选镜像：
# MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-21
#
# ---------- 宿主机端口（可选；被占用时请用 scripts/docker-up.ps1）----------
# GATEWAY_HOST_PORT=8080
# ORDER_HOST_PORT=8081
